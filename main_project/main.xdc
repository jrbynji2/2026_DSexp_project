set_property -dict {PACKAGE_PIN L18  IOSTANDARD LVCMOS33} [get_ports {tft_den}]
set_property -dict {PACKAGE_PIN K18  IOSTANDARD LVCMOS33} [get_ports {tft_disp_en}]
